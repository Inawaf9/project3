### Bank Management System - IntelliJ HTTP Client
### Run requests in order for the initial setup.
### IMPORTANT:
### 1. Create an ADMIN user in the database first (with a BCrypt-encoded password).
### 2. After registration, update customerId, employeeId, accountId, toAccountId
###    to match the IDs generated by your database.
### 3. Account creation currently accepts accountNumber as a query parameter.
### 4. For Basic authentication, use the credentials configured below.
### 5. The negative tests near the end are expected to fail (4xx).

@baseUrl = http://localhost:8080
@adminUsername = admin
@adminPassword = Admin123!
@employeeUsername = employee123
@employeePassword = Password123!
@customerUsername = nawaf123
@customerPassword = Password123!
@secondCustomerUsername = secondcustomer
@secondCustomerPassword = Password123!

@userId = 2
@customerId = 1
@employeeId = 1
@accountId = 1
@toAccountId = 2
@secondCustomerId = 2

### 01 - Register first customer (PUBLIC)
POST {{baseUrl}}/api/v1/customer/register
Content-Type: application/json

{
  "username": "{{customerUsername}}",
  "password": "{{customerPassword}}",
  "name": "Nawaf",
  "email": "nawaf@example.com",
  "phoneNumber": "0512345678"
}

### 02 - Register second customer for transfer tests (PUBLIC)
POST {{baseUrl}}/api/v1/customer/register
Content-Type: application/json

{
  "username": "{{secondCustomerUsername}}",
  "password": "{{secondCustomerPassword}}",
  "name": "Ahmed",
  "email": "ahmed.customer@example.com",
  "phoneNumber": "0598765432"
}

### 03 - Register employee (ADMIN)
POST {{baseUrl}}/api/v1/employee/register
Authorization: Basic {{adminUsername}} {{adminPassword}}
Content-Type: application/json

{
  "username": "{{employeeUsername}}",
  "password": "{{employeePassword}}",
  "name": "Employee Ahmed",
  "email": "employee@example.com",
  "position": "Manager",
  "salary": 8500.00
}

### 04 - Get all users (ADMIN)
GET {{baseUrl}}/api/v1/user/get-all
Authorization: Basic {{adminUsername}} {{adminPassword}}

### 05 - Get user by ID (ADMIN)
GET {{baseUrl}}/api/v1/user/get-by-id/{{userId}}
Authorization: Basic {{adminUsername}} {{adminPassword}}

### 06 - Get all customers (EMPLOYEE or ADMIN)
GET {{baseUrl}}/api/v1/customer/get-all
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 07 - Get customer by ID (EMPLOYEE or ADMIN)
GET {{baseUrl}}/api/v1/customer/get-by-id/{{customerId}}
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 08 - Get my customer profile (CUSTOMER)
GET {{baseUrl}}/api/v1/customer/my-profile
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 09 - Update my customer (CUSTOMER)
### This changes the customer's password, because CustomerDTO requires it.
PUT {{baseUrl}}/api/v1/customer/update/{{customerId}}
Authorization: Basic {{customerUsername}} {{customerPassword}}
Content-Type: application/json

{
  "username": "{{customerUsername}}",
  "password": "{{customerPassword}}",
  "name": "Nawaf Updated",
  "email": "nawaf@example.com",
  "phoneNumber": "0512345678"
}

### 10 - Get all employees (ADMIN)
GET {{baseUrl}}/api/v1/employee/get-all
Authorization: Basic {{adminUsername}} {{adminPassword}}

### 11 - Get employee by ID (ADMIN)
GET {{baseUrl}}/api/v1/employee/get-by-id/{{employeeId}}
Authorization: Basic {{adminUsername}} {{adminPassword}}

### 12 - Update employee (ADMIN)
PUT {{baseUrl}}/api/v1/employee/update/{{employeeId}}
Authorization: Basic {{adminUsername}} {{adminPassword}}
Content-Type: application/json

{
  "username": "{{employeeUsername}}",
  "password": "{{employeePassword}}",
  "name": "Employee Ahmed Updated",
  "email": "employee@example.com",
  "position": "Senior Manager",
  "salary": 9500.00
}

### 13 - Create first account (CUSTOMER)
POST {{baseUrl}}/api/v1/account/add?accountNumber=1111-2222-3333-4444
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 14 - Create destination account for second customer (CUSTOMER)
POST {{baseUrl}}/api/v1/account/add?accountNumber=5555-6666-7777-8888
Authorization: Basic {{secondCustomerUsername}} {{secondCustomerPassword}}

### 15 - Get all accounts (EMPLOYEE or ADMIN)
GET {{baseUrl}}/api/v1/account/get-all
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 16 - Get account by ID (EMPLOYEE or ADMIN)
GET {{baseUrl}}/api/v1/account/get-by-id/{{accountId}}
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 17 - View my account details (CUSTOMER, owner only)
GET {{baseUrl}}/api/v1/account/details/{{accountId}}
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 18 - List my accounts (CUSTOMER)
GET {{baseUrl}}/api/v1/account/my-accounts
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 19 - List second customer's accounts (CUSTOMER)
GET {{baseUrl}}/api/v1/account/my-accounts
Authorization: Basic {{secondCustomerUsername}} {{secondCustomerPassword}}

### 20 - Update account number (EMPLOYEE or ADMIN)
PUT {{baseUrl}}/api/v1/account/update/{{accountId}}?accountNumber=1111-2222-3333-9999
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 21 - Activate first account (EMPLOYEE or ADMIN)
PUT {{baseUrl}}/api/v1/account/activate/{{accountId}}
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 22 - Activate destination account (EMPLOYEE or ADMIN)
PUT {{baseUrl}}/api/v1/account/activate/{{toAccountId}}
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 23 - Deposit money (CUSTOMER, owner only)
PUT {{baseUrl}}/api/v1/account/deposit/{{accountId}}?amount=1000.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 24 - Withdraw money (CUSTOMER, owner only)
PUT {{baseUrl}}/api/v1/account/withdraw/{{accountId}}?amount=150.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 25 - Transfer money between accounts (CUSTOMER, source owner only)
PUT {{baseUrl}}/api/v1/account/transfer/{{accountId}}/{{toAccountId}}?amount=250.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 26 - View balance after transfer (CUSTOMER)
GET {{baseUrl}}/api/v1/account/details/{{accountId}}
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 27 - View destination balance after transfer (CUSTOMER)
GET {{baseUrl}}/api/v1/account/details/{{toAccountId}}
Authorization: Basic {{secondCustomerUsername}} {{secondCustomerPassword}}

### 28 - Block first account (EMPLOYEE or ADMIN)
PUT {{baseUrl}}/api/v1/account/block/{{accountId}}
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### 29 - Reactivate first account (EMPLOYEE or ADMIN)
PUT {{baseUrl}}/api/v1/account/activate/{{accountId}}
Authorization: Basic {{employeeUsername}} {{employeePassword}}

### --- NEGATIVE TESTS: EXPECTED 4xx ---

### 30 - Cannot view another customer's account details (expected 4xx)
GET {{baseUrl}}/api/v1/account/details/{{toAccountId}}
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 31 - Cannot withdraw from another customer's account (expected 4xx)
PUT {{baseUrl}}/api/v1/account/withdraw/{{toAccountId}}?amount=10.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 32 - Cannot withdraw more than the available balance (expected 4xx)
PUT {{baseUrl}}/api/v1/account/withdraw/{{accountId}}?amount=99999999.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 33 - Cannot transfer to the same account (expected 4xx)
PUT {{baseUrl}}/api/v1/account/transfer/{{accountId}}/{{accountId}}?amount=10.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 34 - Cannot deposit a negative amount (expected 4xx)
PUT {{baseUrl}}/api/v1/account/deposit/{{accountId}}?amount=-5.00
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 35 - Customer cannot register an employee (expected 403)
POST {{baseUrl}}/api/v1/employee/register
Authorization: Basic {{customerUsername}} {{customerPassword}}
Content-Type: application/json

{
  "username": "unauthorizedemployee",
  "password": "Password123!",
  "name": "Unauthorized Employee",
  "email": "unauthorized@example.com",
  "position": "Manager",
  "salary": 5000.00
}

### 36 - Customer cannot list all users (expected 403)
GET {{baseUrl}}/api/v1/user/get-all
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 37 - Customer cannot activate an account (expected 403)
PUT {{baseUrl}}/api/v1/account/activate/{{accountId}}
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 38 - Cannot create duplicate username (expected 4xx)
POST {{baseUrl}}/api/v1/customer/register
Content-Type: application/json

{
  "username": "{{customerUsername}}",
  "password": "{{customerPassword}}",
  "name": "Duplicate Customer",
  "email": "different@example.com",
  "phoneNumber": "0500000000"
}

### --- DESTRUCTIVE TESTS: RUN LAST ---
### Customer deletion requires no linked bank accounts.
### Account deletion requires balance = 0. Do not run against accounts holding money.

### 39 - Delete an account with a non-zero balance (expected 4xx after transfer/deposit)
DELETE {{baseUrl}}/api/v1/account/delete/{{accountId}}
Authorization: Basic {{adminUsername}} {{adminPassword}}

### 40 - Delete employee (ADMIN) - destructive
DELETE {{baseUrl}}/api/v1/employee/delete/{{employeeId}}
Authorization: Basic {{adminUsername}} {{adminPassword}}

### 41 - Delete customer (CUSTOMER) - expected 4xx while accounts exist
DELETE {{baseUrl}}/api/v1/customer/delete/{{customerId}}
Authorization: Basic {{customerUsername}} {{customerPassword}}

### 42 - Delete empty account (ADMIN) - set accountId to an account with zero balance
### DELETE {{baseUrl}}/api/v1/account/delete/{{accountId}}
### Authorization: Basic {{adminUsername}} {{adminPassword}}

### 43 - Delete customer after removing all accounts - set customerId accordingly
### DELETE {{baseUrl}}/api/v1/customer/delete/{{customerId}}
### Authorization: Basic {{customerUsername}} {{customerPassword}}
